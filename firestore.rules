rules_version = '2';

// Reglas de seguridad de Firestore para el Radar Social Hiperlocal
// (radar-social/index.html). Pegar en Firebase Console > Firestore
// Database > Rules > Publicar. El UID admin ya está puesto
// (Cqm2OKSnOgUf09Leb8D5YePIcnW2); si el admin cambia, sustituirlo aquí.
//
// Cualquiera puede leer y publicar reportes (comunidad abierta), con
// validación de forma/rango para descartar basura evidente. Votar y
// marcar "ya no ocurre" solo puede tocar esos campos concretos, de uno
// en uno. Borrar y expirar reportes está reservado al UID admin.
service cloud.firestore {
  match /databases/{database}/documents {
    match /radar_reports/{reportId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasAll(['type', 'title', 'desc', 'lat', 'lng', 'ts', 'votes', 'dismisses'])
        && request.resource.data.type in ['lluvia', 'tormenta', 'granizo', 'viento', 'arroyo', 'corte-trafico', 'incidencia']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() < 200
        && request.resource.data.desc is string && request.resource.data.desc.size() < 1000
        && request.resource.data.lat is number && request.resource.data.lat > 36.0 && request.resource.data.lat < 37.2
        && request.resource.data.lng is number && request.resource.data.lng > -5.5 && request.resource.data.lng < -4.0
        && request.resource.data.votes == 1
        && request.resource.data.dismisses == 0
        && request.resource.data.ts is number;

      allow update: if
        (request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2")
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes == resource.data.votes + 1)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismisses'])
          && request.resource.data.dismisses == resource.data.dismisses + 1)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismisses', 'dismissed'])
          && request.resource.data.dismisses == resource.data.dismisses + 1
          && request.resource.data.dismissed == true
          && resource.data.dismisses + 1 >= 3);

      allow delete: if request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2";
    }

    // Panel admin (avisos): a diferencia de radar_reports, esto NO es
    // contenido público-abierto — solo el admin lee y escribe. El contenido
    // se hace público indirectamente, al cabo de unos minutos, cuando el
    // workflow de sincronización (scripts/sync-admin-firestore.js, que usa
    // firebase-admin y por tanto ignora estas reglas) lo copia a
    // data/avisos-locales.json.
    match /admin_avisos/{docId} {
      allow read: if request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2";

      allow create: if
        request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2"
        && request.resource.data.keys().hasAll(['tipo', 'icono', 'titulo', 'detalle', 'estado', 'activo', 'resuelto'])
        && request.resource.data.tipo is string
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() < 200
        && request.resource.data.detalle is string && request.resource.data.detalle.size() < 1000
        && request.resource.data.estado in ['ok', 'warning', 'alert', 'neutral']
        && request.resource.data.activo is bool
        && request.resource.data.resuelto is bool;

      allow update: if request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2";
      allow delete: if request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2";
    }

    // Panel admin (eventos manuales de agenda). Mismo criterio que
    // admin_avisos: solo el admin lee y escribe.
    match /admin_eventos/{docId} {
      allow read: if request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2";

      allow create: if
        request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2"
        && request.resource.data.keys().hasAll(['tipo', 'titulo', 'descripcion', 'lugar', 'activo'])
        && request.resource.data.tipo is string
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() < 200
        && request.resource.data.descripcion is string && request.resource.data.descripcion.size() < 1000
        && request.resource.data.lugar is string
        && request.resource.data.activo is bool;

      allow update: if request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2";
      allow delete: if request.auth != null && request.auth.uid == "Cqm2OKSnOgUf09Leb8D5YePIcnW2";
    }
  }
}
