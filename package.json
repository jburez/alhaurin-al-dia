{
  "name": "alhaurin-al-dia",
  "private": true,
  "scripts": {
    "news": "python3 scripts/generar_noticias.py",
    "news:dedupe": "node scripts/dedupe-news.js --write",
    "news:dedupe:dry": "node scripts/dedupe-news.js",
    "news:orphans:dry": "node scripts/clean-orphan-news.js",
    "news:orphans:clean": "node scripts/clean-orphan-news.js --delete",
    "seo:home": "node scripts/apply-home-seo.js",
    "seo:clean-searchaction": "node scripts/remove-searchaction.js",
    "seo": "npm run seo:home && npm run seo:clean-searchaction",
    "home:static": "node scripts/render-home-static.js",
    "guide:pages": "node scripts/render-guide-pages.js",
    "sitemap": "node scripts/generate-sitemaps.js",
    "seo:audit": "node scripts/audit-seo.js --warn-only",
    "seo:audit:strict": "node scripts/audit-seo.js",
    "seo:orphans": "node scripts/audit-orphan-pages.js --warn-only",
    "seo:orphans:strict": "node scripts/audit-orphan-pages.js",
    "publish:check": "node scripts/check-publish.js",
    "daily": "npm run build && npm run publish:check",
    "build": "npm run news && npm run news:dedupe && npm run seo && npm run home:static && npm run guide:pages && npm run sitemap && npm run seo:audit && npm run seo:orphans"
  }
}
