{
  "name": "alhaurin-al-dia",
  "private": true,
  "scripts": {
    "news": "python3 scripts/generar_noticias_seguro.py",
    "news:dedupe": "node scripts/dedupe-news.js --write",
    "news:dedupe:dry": "node scripts/dedupe-news.js",
    "news:orphans:dry": "node scripts/archive-orphan-news.js",
    "news:orphans:archive": "node scripts/archive-orphan-news.js --write",
    "news:static": "node scripts/render-news-static.js",
    "news:archive:page": "node scripts/render-news-archive.js",
    "seo:home": "node scripts/apply-home-seo.js",
    "seo:clean-searchaction": "node scripts/remove-searchaction.js",
    "seo:twitter-cards": "node scripts/add-twitter-cards.js",
    "seo": "npm run seo:home && npm run seo:clean-searchaction",
    "home:static": "node scripts/render-home-static.js",
    "guide:pages": "node scripts/render-guide-pages.js",
    "guide:static": "node scripts/render-guide-static.js",
    "farmacia:static": "node scripts/render-farmacia-guardia-static.js",
    "boletin:static": "node scripts/render-boletin-static.js",
    "tiempo:static": "node scripts/render-tiempo-static.js",
    "home:widgets": "node scripts/render-home-widgets-static.js",
    "news:rss": "node scripts/generate-news-rss.js",
    "whatsapp:today": "node scripts/generate-whatsapp-summary.js",
    "sitemap": "node scripts/generate-sitemaps.js && npm run news:rss",
    "seo:audit": "node scripts/audit-seo.js --warn-only",
    "seo:audit:strict": "node scripts/audit-seo.js",
    "seo:orphans": "node scripts/audit-orphan-pages.js --warn-only",
    "seo:orphans:strict": "node scripts/audit-orphan-pages.js",
    "publish:check": "node scripts/check-publish.js",
    "daily": "npm run build && npm run publish:check",
    "build": "npm run news && npm run news:dedupe && npm run news:orphans:archive && npm run news:static && npm run news:archive:page && npm run news:rss && npm run seo && npm run home:static && npm run farmacia:static && npm run home:widgets && npm run boletin:static && npm run tiempo:static && npm run guide:pages && npm run guide:static && npm run seo:twitter-cards && npm run sitemap && npm run seo:audit && npm run seo:orphans",
    "build:publish": "npm run build && npm run publish:check",
    "admin:sync": "node scripts/sync-admin-firestore.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  }
}
